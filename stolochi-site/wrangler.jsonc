{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stolochi-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-23",
  // global_fetch_strictly_public is required by the OpenNext adapter: without it a
  // fetch to the Worker's own hostname loops back and fails with error 1042.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Self-reference binding; the service name must match the Worker name above.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "stolochi-site"
    }
  ],
  // Not a secret: this ID is part of the sheet's public share URL.
  "vars": {
    "GOOGLE_SHEETS_SPREADSHEET_ID": "1PJDWBX4vFmMddb5Typ44Sc1v9UJbALIUutsH85umrcQ"
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
